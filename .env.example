# Database
MONGODB_URI=mongodb://localhost:27017/goodsolutions

# Authentication (generate with: openssl rand -base64 32)
AUTH_SECRET=your-auth-secret-min-32-chars-long-replace-me

# Field-level encryption for sensitive credentials (min 32 characters)
ENCRYPTION_KEY=your-encryption-key-min-32-characters-long

# Super Admin Seed (used by npm run seed)
SUPER_ADMIN_EMAIL=admin@goodsolutions.com
SUPER_ADMIN_PASSWORD=ChangeMe@123!
SUPER_ADMIN_NAME=Super Admin
# Set to true to reset super admin password to SUPER_ADMIN_PASSWORD
# SUPER_ADMIN_RESET_PASSWORD=true

# App
APP_ENV=development
# Production only — must match your public URL. Omit in local dev (use AUTH_TRUST_HOST).
# AUTH_URL=https://your-domain.com
AUTH_TRUST_HOST=true

# CORS (enabled automatically when APP_ENV=development)
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting (API abuse protection)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
